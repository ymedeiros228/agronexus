# Conta na nuvem (Supabase). Sem estas duas, o app funciona só no aparelho.
# Os valores ficam em .env.local (nunca no git) e nas variáveis do projeto na Vercel.
# Use a chave PÚBLICA (publishable). A chave de serviço (secret/service_role) nunca entra no app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
